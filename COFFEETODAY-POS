function renderSell(){
  var b=$('chSeg').querySelectorAll('button');for(var i=0;i<b.length;i++)b[i].classList.toggle('on',b[i].getAttribute('data-v')===S.ch);
  var gs=groups(),cs=cats(gs);
  if(!S.cat||cs.indexOf(S.cat)<0)S.cat=cs[0]||null;
  var q=S.q.trim().toLowerCase();
  var h='';
  if(!q){for(var c=0;c<cs.length;c++)h+='<button class="cat'+(cs[c]===S.cat?' on':'')+'" data-act="cat" data-v="'+esc(cs[c])+'">'+esc(cs[c])+'</button>';}
  $('cats').innerHTML=h;
  var list=gs.filter(function(g){
    if(q){if(g.grp.toLowerCase().indexOf(q)>=0)return true;for(var i=0;i<g.items.length;i++)if((g.items[i].receipt_name||'').toLowerCase().indexOf(q)>=0)return true;return false;}
    return g.cat===S.cat;});
  var gh='';
  for(var j=0;j<list.length;j++){
