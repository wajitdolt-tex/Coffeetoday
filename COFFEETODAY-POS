<!DOCTYPE html>

<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="CT POS">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#2B1D14">
<meta name="format-detection" content="telephone=no">
<title>COFFEETODAY POS</title>
<style>
:root{
  --bg:#F4EEE6;--panel:#FFFFFF;--ink:#2B1D14;--muted:#7D6B5D;--line:#E7DCCF;
  --brand:#6B3E1F;--brand2:#8A5530;--brandInk:#FFFFFF;--soft:#F8F2EA;
  --ok:#1E7B46;--okBg:#E3F3EA;--warn:#A86500;--warnBg:#FFF1D6;--err:#B3261E;--errBg:#FBE4E2;
  --lm:#00A74F;--lmBg:#E2F6EA;--shadow:0 6px 24px rgba(43,29,20,.12)
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#17110E;--panel:#221A15;--ink:#F3EAE1;--muted:#B3A293;--line:#3A2E26;
  --brand:#C98B55;--brand2:#E0A46E;--brandInk:#1A120D;--soft:#2A201A;
  --ok:#5CC98A;--okBg:#173525;--warn:#F0B35A;--warnBg:#3A2A10;--err:#F2857D;--errBg:#3D1A17;
  --lm:#3DDB86;--lmBg:#123423;--shadow:0 6px 24px rgba(0,0,0,.45)}}
:root[data-theme="dark"]{
  --bg:#17110E;--panel:#221A15;--ink:#F3EAE1;--muted:#B3A293;--line:#3A2E26;
  --brand:#C98B55;--brand2:#E0A46E;--brandInk:#1A120D;--soft:#2A201A;
  --ok:#5CC98A;--okBg:#173525;--warn:#F0B35A;--warnBg:#3A2A10;--err:#F2857D;--errBg:#3D1A17;
  --lm:#3DDB86;--lmBg:#123423;--shadow:0 6px 24px rgba(0,0,0,.45)}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{background:var(--bg);color:var(--ink);font-family:-apple-system,"Sukhumvit Set","Helvetica Neue",sans-serif;font-size:15px;-webkit-user-select:none;user-select:none;overflow:hidden}
input,textarea,select{-webkit-user-select:text;user-select:text;font-family:inherit;font-size:16px;color:var(--ink)}
button{font-family:inherit;color:inherit;cursor:pointer}
.hide{display:none!important}

/* HEADER */
#hdr{height:58px;padding:0 12px;padding-top:env(safe-area-inset-top);box-sizing:content-box;background:#2B1D14;color:#F6EDE3;display:flex;align-items:center;gap:10px}
#hdr .brand{display:flex;align-items:center;gap:8px;min-width:0}
#hdr .brand img{width:34px;height:34px;background:#fff;border-radius:8px;padding:2px}
#hdr .bn{font-weight:800;font-size:15px;letter-spacing:.5px;white-space:nowrap}
#hdr .bs{font-size:11px;opacity:.75;white-space:nowrap}
#nav{display:flex;gap:4px;margin-left:auto}
#nav button{background:transparent;border:none;color:#E9DCCD;padding:8px 10px;border-radius:10px;font-size:13px;font-weight:700;display:flex;align-items:center;gap:5px}
#nav button.on{background:#C98B55;color:#1A120D}
#nav .ic{font-size:16px}
#sync{display:flex;align-items:center;gap:6px;font-size:11px;background:rgba(255,255,255,.1);padding:6px 9px;border-radius:20px;white-space:nowrap}
#sync .dot{width:9px;height:9px;border-radius:50%;background:#9A8B7E}
#sync.ok .dot{background:#5CC98A}#sync.busy .dot{background:#F0B35A}#sync.err .dot{background:#F2857D}
@media (max-width:899px){#nav .tx{display:none}#nav button{padding:8px}#hdr .bs{display:none}}
@media (max-width:520px){#sync .tx{display:none}#hdr .brand>div{display:none}#nav{gap:2px}}

main{height:calc(100% - 58px - env(safe-area-inset-top));overflow:hidden}
.view{height:100%;overflow:auto;-webkit-overflow-scrolling:touch}
.pad{padding:14px;max-width:1100px;margin:0 auto}

/* SELL */
#v-sell{overflow:hidden}
.sell{display:grid;grid-template-columns:1fr 380px;height:100%}
.mpane{display:flex;flex-direction:column;min-width:0;height:100%}
.stop{display:flex;gap:8px;padding:10px 12px 6px;align-items:center}
.seg{display:flex;background:var(--soft);border:1px solid var(--line);border-radius:12px;padding:3px;gap:3px}
.seg button{border:none;background:transparent;padding:8px 14px;border-radius:9px;font-weight:700;font-size:14px;color:var(--muted);white-space:nowrap}
.seg button.on{background:var(--brand);color:var(--brandInk)}
.seg button.on.lm{background:var(--lm);color:#fff}
.search{flex:1;min-width:0;border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:9px 12px}
#cats{display:flex;gap:6px;overflow-x:auto;padding:4px 12px 8px;scrollbar-width:none;flex-shrink:0}
#cats::-webkit-scrollbar{display:none}
.cat{flex-shrink:0;border:1px solid var(--line);background:var(--panel);padding:8px 14px;border-radius:20px;font-weight:700;font-size:13px;color:var(--muted)}
.cat.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
#grid{flex:1;overflow:auto;-webkit-overflow-scrolling:touch;padding:4px 12px 90px;display:grid;grid-template-columns:repeat(auto-fill,minmax(136px,1fr));gap:10px;align-content:start}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 10px;text-align:left;min-height:92px;display:flex;flex-direction:column;justify-content:space-between;gap:6px;box-shadow:0 1px 0 rgba(0,0,0,.03)}
.card:active{transform:scale(.97)}
.card .nm{font-weight:700;font-size:15px;line-height:1.3}
.card .pr{font-weight:800;color:var(--brand);font-size:15px}
.card .vs{font-size:11px;color:var(--muted)}
.card.so{opacity:.45}
.card.so .pr::after{content:" · หมด";color:var(--err)}
.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:40px 10px;line-height:1.7}

#cart{background:var(--panel);border-left:1px solid var(--line);display:flex;flex-direction:column;height:100%;min-height:0}
.chd{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid var(--line)}
.chd b{font-size:16px}
.lnk{background:none;border:none;color:var(--err);font-weight:700;font-size:13px;padding:4px}
#cartList{flex:1;overflow:auto;-webkit-overflow-scrolling:touch;padding:4px 14px}
.cl{padding:10px 0;border-bottom:1px dashed var(--line)}
.cl .r1{display:flex;gap:8px;align-items:flex-start}
.cl .nm{flex:1;font-weight:700;line-height:1.3}
.cl .sub{font-size:12px;color:var(--muted);margin-top:2px;line-height:1.45}
.cl .amt{font-weight:800;white-space:nowrap}
.cl .r2{display:flex;align-items:center;gap:8px;margin-top:8px}
.qty{display:flex;align-items:center;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.qty button{width:36px;height:34px;border:none;background:var(--soft);font-size:18px;font-weight:700}
.qty span{min-width:34px;text-align:center;font-weight:800}
.mini{border:1px solid var(--line);background:var(--panel);border-radius:9px;padding:7px 10px;font-size:12px;font-weight:700}
.mini.del{color:var(--err)}
.cft{padding:12px 14px;border-top:1px solid var(--line);padding-bottom:calc(12px + env(safe-area-inset-bottom))}
.trow{display:flex;justify-content:space-between;font-size:14px;color:var(--muted);margin-bottom:4px}
.trow.big{font-size:22px;color:var(--ink);font-weight:800;margin:6px 0 10px}
.btn{display:block;width:100%;border:none;border-radius:14px;padding:15px;font-size:17px;font-weight:800;background:var(--brand);color:var(--brandInk)}
.btn:disabled{opacity:.4}
.btn.lm{background:var(--lm);color:#fff}
.btn.ghost{background:var(--soft);color:var(--ink);border:1px solid var(--line)}
.btn.danger{background:var(--err);color:#fff}
.btn.sm{padding:11px;font-size:15px;border-radius:12px}
#cartBar{display:none}
@media (max-width:899px){
  .sell{grid-template-columns:1fr}
  #cart{position:fixed;left:0;right:0;bottom:0;top:12%;height:auto;z-index:40;border-left:none;border-radius:18px 18px 0 0;box-shadow:var(--shadow);transform:translateY(105%);transition:transform .25s}
  #cart.open{transform:translateY(0)}
  #cartBar{display:flex;position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:30;background:var(--brand);color:var(--brandInk);border-radius:16px;padding:14px 16px;align-items:center;justify-content:space-between;font-weight:800;box-shadow:var(--shadow);border:none;font-size:16px}
  #cartBar.lm{background:var(--lm);color:#fff}
  #cartBar.zero{opacity:.5}
  #cartShade{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:35}
}

/* LIST / CARDS */
.box{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px}
.box h3{font-size:15px;margin-bottom:10px}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.in{border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:9px 11px;min-width:0}
.in.sm{width:90px}
.lbl{font-size:12px;color:var(--muted);font-weight:700;margin-bottom:4px;display:block}
.fld{margin-bottom:10px}
.fld .in{width:100%}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.bill{display:flex;align-items:center;gap:10px;padding:12px 4px;border-bottom:1px solid var(--line)}
.bill:last-child{border-bottom:none}
.bill .t{font-size:12px;color:var(--muted);width:44px}
.bill .no{font-weight:800;font-size:14px}
.bill .ds{font-size:12px;color:var(--muted);margin-top:2px}
.bill .am{margin-left:auto;font-weight:800;white-space:nowrap}
.bill.void .am{text-decoration:line-through;color:var(--err)}
.tag{display:inline-block;font-size:11px;font-weight:800;border-radius:6px;padding:2px 6px;margin-right:4px}
.tag.lm{background:var(--lmBg);color:var(--lm)}
.tag.v{background:var(--errBg);color:var(--err)}
.tag.q{background:var(--warnBg);color:var(--warn)}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:12px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px}
.stat .k{font-size:12px;color:var(--muted);font-weight:700}
.stat .v{font-size:22px;font-weight:800;margin-top:4px}
.bar{display:flex;align-items:center;gap:8px;margin:6px 0;font-size:13px}
.bar .bl{width:150px;flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar .bt{flex:1;height:14px;background:var(--soft);border-radius:7px;overflow:hidden}
.bar .bf{height:100%;background:var(--brand);border-radius:7px}
.bar .bv{width:90px;text-align:right;font-weight:700}
.hours{display:flex;align-items:flex-end;gap:3px;height:110px}
.hours div{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%}
.hours i{display:block;width:100%;background:var(--brand2);border-radius:4px 4px 0 0;min-height:2px}
.hours span{font-size:9px;color:var(--muted);margin-top:3px}
.sumtbl{width:100%;border-collapse:collapse;font-size:14px}
.sumtbl td{padding:6px 2px;border-bottom:1px solid var(--line)}
.sumtbl td.r{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
.sumtbl tr.h td{font-weight:800;border-bottom:2px solid var(--ink)}
.sumtbl tr.s td{padding-left:18px;color:var(--muted)}
.sumtbl tr.big td{font-size:17px;font-weight:800}
.atabs{display:flex;gap:6px;overflow-x:auto;margin-bottom:12px;scrollbar-width:none}
.mrow{display:grid;grid-template-columns:1fr 84px 84px 52px 52px 40px;gap:6px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}
.mrow .n{font-weight:700;font-size:14px;line-height:1.3}
.mrow .n small{display:block;font-weight:500;color:var(--muted);font-size:11px}
.mrow .in{width:100%;padding:7px 6px;text-align:right}
.mhd{font-size:11px;color:var(--muted);font-weight:800}
.tg{width:46px;height:28px;border-radius:14px;border:none;background:var(--line);position:relative}
.tg::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:left .15s}
.tg.on{background:var(--ok)}
.tg.on::after{left:21px}
.tg.so.on{background:var(--err)}
@media (max-width:600px){.mrow{grid-template-columns:1fr 70px 70px 48px 40px}.mrow .c-so{display:none}.row2{grid-template-columns:1fr}}

/* MODAL */
#shade{position:fixed;inset:0;background:rgba(20,12,8,.5);z-index:60;display:none}
#modal{position:fixed;z-index:61;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,94vw);max-height:92vh;overflow:auto;-webkit-overflow-scrolling:touch;background:var(--panel);border-radius:20px;box-shadow:var(--shadow);display:none}
#modal.wide{width:min(760px,96vw)}
.mh{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 10px;position:sticky;top:0;background:var(--panel);z-index:2}
.mh h2{font-size:19px}
.x{border:none;background:var(--soft);width:36px;height:36px;border-radius:50%;font-size:18px;font-weight:700}
.mb{padding:4px 18px 18px}
.opts{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.opt{border:1.5px solid var(--line);background:var(--panel);border-radius:12px;padding:11px 14px;font-weight:700;font-size:14px;text-align:center;min-width:96px}
.opt small{display:block;font-weight:600;color:var(--muted);font-size:12px;margin-top:2px}
.opt.on{border-color:var(--brand);background:var(--soft);box-shadow:inset 0 0 0 1px var(--brand)}
.opt.on small{color:var(--brand)}
.opt:disabled{opacity:.35}
.sec{font-size:13px;font-weight:800;color:var(--muted);margin:6px 0 8px}
.adl{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line)}
.adl .an{font-weight:600;font-size:14px}
.adl .ap{font-size:12px;color:var(--muted)}
.paybig{text-align:center;padding:4px 0 12px}
.paybig .k{font-size:13px;color:var(--muted);font-weight:700}
.paybig .v{font-size:40px;font-weight:900;letter-spacing:-.5px}
.paybig .s{font-size:13px;color:var(--muted)}
.mgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin-bottom:14px}
.mt{border:1.5px solid var(--line);background:var(--panel);border-radius:14px;padding:14px 8px;font-weight:800;font-size:14px;text-align:center}
.mt .ic{font-size:22px;display:block;margin-bottom:4px}
.mt.on{border-color:var(--brand);background:var(--soft);box-shadow:inset 0 0 0 1px var(--brand)}
.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
.quick button{border:1px solid var(--line);background:var(--soft);border-radius:12px;padding:12px;font-weight:800;font-size:16px}
.change{background:var(--okBg);color:var(--ok);border-radius:14px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:18px;margin:6px 0 12px}
.change.bad{background:var(--errBg);color:var(--err)}
#qrBox{display:flex;justify-content:center;padding:12px;background:#fff;border-radius:14px;margin:6px auto 12px;width:fit-content}
.note{font-size:13px;color:var(--muted);line-height:1.6}
.warnbox{background:var(--warnBg);color:var(--warn);border-radius:12px;padding:10px 12px;font-size:13px;font-weight:600;line-height:1.5;margin-bottom:12px}
.okbig{text-align:center;padding:10px 0}
.okbig .ic{font-size:46px}
.okbig .t{font-size:20px;font-weight:800;margin-top:4px}
.okbig .c{font-size:44px;font-weight:900;color:var(--ok);margin:6px 0}
.btns{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.pinpad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:300px;margin:10px auto}
.pinpad button{height:62px;border-radius:16px;border:1px solid var(--line);background:var(--soft);font-size:24px;font-weight:800}
.pdots{display:flex;justify-content:center;gap:14px;margin:8px 0 4px}
.pdots i{width:16px;height:16px;border-radius:50%;border:2px solid var(--brand)}
.pdots i.f{background:var(--brand)}
.perr{text-align:center;color:var(--err);font-size:13px;height:18px;font-weight:700}

/* SETUP */
#setup{position:fixed;inset:0;z-index:80;background:var(--bg);display:none;overflow:auto;padding:30px 16px}
#setup .in{width:100%}

/* TOAST */
#toasts{position:fixed;left:50%;transform:translateX(-50%);top:calc(70px + env(safe-area-inset-top));z-index:90;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none;width:92vw}
.toast{background:#2B1D14;color:#fff;padding:11px 16px;border-radius:12px;font-weight:700;font-size:14px;box-shadow:var(--shadow);max-width:100%;text-align:center}
.toast.err{background:#B3261E}.toast.ok{background:#1E7B46}
</style>
</head>
<body>

<header id="hdr">
  <div class="brand">
    <img id="hdrLogo" alt="">
    <div><div class="bn">COFFEE TODAY POS</div><div class="bs" id="hdrSub">—</div></div>
  </div>
  <nav id="nav">
    <button data-act="view" data-v="sell" class="on"><span class="ic">☕</span><span class="tx">ขาย</span></button>
    <button data-act="view" data-v="bills"><span class="ic">🧾</span><span class="tx">บิล</span></button>
    <button data-act="view" data-v="summary"><span class="ic">📊</span><span class="tx">สรุปยอด</span></button>
    <button data-act="view" data-v="shift"><span class="ic">💵</span><span class="tx">กะ</span></button>
    <button data-act="view" data-v="admin"><span class="ic">⚙️</span><span class="tx">หลังบ้าน</span></button>
  </nav>
  <div id="sync" data-act="syncNow"><span class="dot"></span><span class="tx" id="syncTx">—</span></div>
</header>

<main>
  <section class="view" id="v-sell">
    <div class="sell">
      <div class="mpane">
        <div class="stop">
          <div class="seg" id="chSeg">
            <button data-act="ch" data-v="walkin" class="on">🏪 หน้าร้าน</button>
            <button data-act="ch" data-v="lineman" class="lm">🛵 LINE MAN</button>
          </div>
          <input class="search" id="q" type="search" placeholder="ค้นหาเมนู…" autocomplete="off">
        </div>
        <div id="cats"></div>
        <div id="grid"></div>
      </div>
      <aside id="cart">
        <div class="chd"><b>ตะกร้า <span id="cartCh"></span></b><button class="lnk" data-act="clearCart">ล้าง</button></div>
        <div id="cartList"></div>
        <div class="cft">
          <div class="trow"><span>จำนวน</span><span id="cCnt">0</span></div>
          <div class="trow big"><span>รวม</span><span id="cTot">฿0</span></div>
          <button class="btn" id="payBtn" data-act="openPay" disabled>💳 ชำระเงิน</button>
        </div>
      </aside>
    </div>
    <div id="cartShade" class="hide" data-act="closeCart"></div>
    <button id="cartBar" data-act="openCart" class="zero"><span id="cbL">ตะกร้าว่าง</span><span id="cbR">฿0</span></button>
  </section>

  <section class="view hide" id="v-bills"><div class="pad" id="billsPad"></div></section>
  <section class="view hide" id="v-summary"><div class="pad" id="sumPad"></div></section>
  <section class="view hide" id="v-shift"><div class="pad" id="shiftPad"></div></section>
  <section class="view hide" id="v-admin"><div class="pad" id="adminPad"></div></section>
</main>

<div id="shade" data-act="shadeClose"></div>
<div id="modal"></div>
<div id="setup"></div>
<div id="toasts"></div>

<script>
/* QR generator — Kazuhiko Arase (MIT), via qrcode-terminal vendor; inlined so QR works offline */
var QRLib=(function(){var M={"./QRErrorCorrectLevel":function(module,exports,require){
module.exports = {
	L : 1,
	M : 0,
	Q : 3,
	H : 2
};


},
"./QRPolynomial":function(module,exports,require){
var QRMath = require('./QRMath');

function QRPolynomial(num, shift) {
	if (num.length === undefined) {
		throw new Error(num.length + "/" + shift);
	}

	var offset = 0;

	while (offset < num.length && num[offset] === 0) {
		offset++;
	}

	this.num = new Array(num.length - offset + shift);
	for (var i = 0; i < num.length - offset; i++) {
		this.num[i] = num[i + offset];
	}
}

QRPolynomial.prototype = {

	get : function(index) {
		return this.num[index];
	},
	
	getLength : function() {
		return this.num.length;
	},
	
	multiply : function(e) {
	
		var num = new Array(this.getLength() + e.getLength() - 1);
	
		for (var i = 0; i < this.getLength(); i++) {
			for (var j = 0; j < e.getLength(); j++) {
