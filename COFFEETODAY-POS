/* ---------------- PromptPay QR (EMVCo) ---------------- */
function tlv(id,v){return id+pad(v.length,2)+v;}
function crc16(s){var c=0xFFFF;for(var i=0;i<s.length;i++){c^=s.charCodeAt(i)<<8;for(var j=0;j<8;j++)c=(c&0x8000)?((c<<1)^0x1021):(c<<1);c&=0xFFFF;}return ('0000'+c.toString(16).toUpperCase()).slice(-4);}
function promptPayPayload(target,amount){
  var t=String(target||'').replace(/[^0-9]/g,''),tag;
  if(t.length>=15){tag='03';}
  else if(t.length>=13){tag='02';}
  else {tag='01';t=('0000000000000'+t.replace(/^0/,'66')).slice(-13);}
  var mi=tlv('00','A000000677010111')+tlv(tag,t);
  var p=tlv('00','01')+tlv('01',amount>0?'12':'11')+tlv('29',mi)+tlv('53','764')+(amount>0?tlv('54',r2(amount).toFixed(2)):'')+tlv('58','TH')+'6304';
  return p+crc16(p);
}
function qrSVG(text,size){
  var q=new QRLib.QRCode(-1,QRLib.ECL.M);q.addData(text);q.make();
  var n=q.getModuleCount(),qz=2,tot=n+qz*2,d='';
  for(var r=0;r<n;r++)for(var c=0;c<n;c++)if(q.isDark(r,c))d+='M'+(c+qz)+' '+(r+qz)+'h1v1h-1z';
  return '<svg xmlns="http://www.w3.org/2000/svg" width="'+size+'" height="'+size+'" viewBox="0 0 '+tot+' '+tot+'" shape-rendering="crispEdges"><rect width="'+tot+'" height="'+tot+'" fill="#fff"/><path d="'+d+'" fill="#000"/></svg>';
}
function drawQR(el,target,amount){
  try{el.innerHTML=qrSVG(promptPayPayload(target,amount),240);}catch(e){el.textContent='สร้าง QR ไม่ได้';}
}

