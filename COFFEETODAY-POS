/* seed menu from recipes */
function parseRecipe(r,idx){
  var n=String(r.name||'').trim(),temp='',base=n;
  var m=n.match(/^(.*?)\s*(รอน|ร้อน|เย็น|ปั่น)$/);
  if(m&&m[1]){base=m[1].trim();temp=m[2]==='รอน'?'ร้อน':m[2];}
  var sz=String(r.size||'').trim(),oz='';
  var mz=sz.match(/^(\d+)\s*oz$/i);if(mz)oz=mz[1]+' oz';
  var cat=CAT_MERGE[r.category]||r.category||'อื่นๆ';
  var isAdd=r.category==='แอดเพิ่ม';
  var kind=(SNACK_CATS.indexOf(r.category)>=0||/^(snack_|toast_)/.test(r.id))?'snack':'drink';
  var variant=isAdd?'':([temp,oz].join(' ').trim()||'');
  var rn=base+temp+(oz?' '+oz:'');
  var k=KNOWN[r.id];
  return {id:'m_'+r.id,grp:base,variant:variant,receipt_name:k?k.rn:rn,category:cat,recipe_id:r.id,kind:kind,is_addon:isAdd,
    price:k?k.p:null,price_lm:null,bp:{},so:{},active:r.hide_from_sales!==true,sort:(r.sort_order!=null?Number(r.sort_order):idx)*10};
}
function seedFromRecipes(){
  toast('กำลังดึงสูตรจาก Stock…');
  sb('GET','recipes?select=id,name,size,category,hide_from_sales,sort_order&order=sort_order.asc,id.asc').then(function(rs){
    RECIPES=rs||[];lsSet('recipes',RECIPES);
    var have={},add=[];for(var i=0;i<MENU.length;i++){have[MENU[i].id]=1;if(MENU[i].recipe_id)have['m_'+MENU[i].recipe_id]=1;}
    for(var j=0;j<RECIPES.length;j++){var it=parseRecipe(RECIPES[j],j);if(!have[it.id])add.push(it);}
    for(var x=0;x<EXTRA_MENU.length;x++)if(!have[EXTRA_MENU[x].id])add.push(ext(clone(EXTRA_MENU[x]),{bp:{},so:{},active:true}));
    if(!add.length){toast('เมนูครบแล้ว ไม่มีสูตรใหม่','ok');return;}
    var now=new Date().toISOString();for(var a=0;a<add.length;a++)add[a].updated_at=now;
    return upsert('pos_menu',add).then(function(){MENU=MENU.concat(add);lsSet('menu',MENU);toast('เพิ่มเมนู '+add.length+' รายการ','ok');renderAll();if(S.view==='admin')renderAdmin();});
  }).catch(function(e){toast('ดึงสูตรไม่สำเร็จ: '+e.message,'err');});
}
