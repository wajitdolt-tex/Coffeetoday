function expectedCash(sh){
  var from=ymd(new Date(sh.opened_at));
  return fetchOrders(from,ymd(),CFG.branch).then(function(res){
    var cash=0,cnt=0;
    for(var i=0;i<res.rows.length;i++){var o=res.rows[i];if(o.status==='void'||o.created_at<sh.opened_at)continue;
      for(var p=0;p<o.payments.length;p++)if(o.payments[p].type==='cash'){cash+=+o.payments[p].amt;cnt++;}}
    return {cash:r2(cash),cnt:cnt,exp:r2((+sh.open_cash||0)+cash),offline:res.offline};
  });
}
