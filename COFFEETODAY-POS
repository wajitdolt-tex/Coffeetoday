function loadRemote(){
  var p1=sb('GET','pos_settings?select=*&key=eq.main').then(function(r){
    if(r&&r.length&&r[0].value){SET=ext(clone(DEFAULT_SETTINGS),r[0].value);mergeDefaultsPay();lsSet('settings',SET);}
  });
  var p2=sb('GET','pos_menu?select=*&order=sort.asc,id.asc&limit=5000').then(function(r){MENU=r||[];lsSet('menu',MENU);});
  var p3=sb('GET','pos_promos?select=*&order=sort.asc').then(function(r){PROMOS=r||[];lsSet('promos',PROMOS);});
  return Promise.all([p1,p2,p3]).then(function(){S.online=true;setSync(OUTBOX.length?'busy':'ok');renderAll();flush();},function(e){
    setSync('err');
    if(/42P01|does not exist|404/.test(String(e.message)))toast('ยังไม่พบตาราง POS ใน Supabase — รันไฟล์ SQL ก่อน','err');
    renderAll();
  });
}
function mergeDefaultsPay(){
  var have={};for(var i=0;i<SET.pay.length;i++)have[SET.pay[i].id]=1;
  for(var j=0;j<DEFAULT_SETTINGS.pay.length;j++){var d=DEFAULT_SETTINGS.pay[j];if(!have[d.id])SET.pay.push(clone(d));}
  if(!SET.branches)SET.branches=clone(DEFAULT_SETTINGS.branches);
  for(var b in DEFAULT_SETTINGS.branches)if(!SET.branches[b])SET.branches[b]=clone(DEFAULT_SETTINGS.branches[b]);
}
function recoverSeq(){
  var d=ymd(),pre=billPrefix(d);
  sb('GET','pos_orders?select=bill_no&bill_no=like.'+encodeURIComponent(pre+'*')+'&order=bill_no.desc&limit=1').then(function(r){
    if(r&&r.length){var n=parseInt(r[0].bill_no.split('-').pop(),10)||0;var k='seq_'+d;if(n>lsGet(k,0))lsSet(k,n);}
  },function(){});
}

/* ---------------- menu helpers ---------------- */
function priceOf(it,ch){
  var o=(it.bp&&it.bp[CFG.branch])||{};
  var p=(o.p!=null&&o.p!=='')?Number(o.p):(it.price!=null&&it.price!==''?Number(it.price):null);
  if(ch==='lineman'){var l=(o.lm!=null&&o.lm!=='')?Number(o.lm):(it.price_lm!=null&&it.price_lm!==''?Number(it.price_lm):null);if(l!=null)return l;}
  return p;
}
function isSoldOut(it){return !!(it.so&&it.so[CFG.branch]);}
function sellable(it){return it.active!==false&&!it.is_addon&&priceOf(it,'walkin')!=null;}
function menuById(id){for(var i=0;i<MENU.length;i++)if(MENU[i].id===id)return MENU[i];return null;}
function groups(){
  var g={},order=[];
  for(var i=0;i<MENU.length;i++){var it=MENU[i];if(!sellable(it))continue;
    var k=(it.category||'อื่นๆ')+'|'+it.grp;
    if(!g[k]){g[k]={key:k,cat:it.category||'อื่นๆ',grp:it.grp,items:[],sort:it.sort||0};order.push(k);}
    g[k].items.push(it);if((it.sort||0)<g[k].sort)g[k].sort=it.sort||0;}
  var arr=order.map(function(k){return g[k];});
  arr.sort(function(a,b){return a.sort-b.sort;});
  for(var j=0;j<arr.length;j++)arr[j].items.sort(function(a,b){return (a.sort||0)-(b.sort||0);});
  return arr;
}
function cats(gs){var seen={},out=[];for(var i=0;i<gs.length;i++){if(!seen[gs[i].cat]){seen[gs[i].cat]=1;out.push(gs[i].cat);}}return out;}
function addons(){return MENU.filter(function(it){return it.is_addon&&it.active!==false&&priceOf(it,'walkin')!=null;}).sort(function(a,b){return (a.sort||0)-(b.sort||0);});}

