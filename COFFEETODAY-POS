/* ---------------- events ---------------- */
document.addEventListener('click',function(e){
  var t=e.target;while(t&&t!==document&&!t.getAttribute('data-act'))t=t.parentNode;
  if(!t||t===document)return;
  var a=t.getAttribute('data-act'),v=t.getAttribute('data-v'),i=+t.getAttribute('data-i'),d=+t.getAttribute('data-d');
  switch(a){
    case 'view':setView(v);break;
    case 'syncNow':flush();loadRemote();break;
    case 'ch':if(S.ch!==v){S.ch=v;repriceCart();renderHeader();renderSell();}break;
    case 'cat':S.cat=v;renderSell();break;
    case 'grp':openPicker(v,null);break;
    case 'openCart':$('cart').classList.add('open');$('cartShade').classList.remove('hide');break;
    case 'closeCart':closeCart();break;
    case 'clearCart':if(S.cart.length&&confirm('ล้างตะกร้า?')){S.cart=[];renderCart();}break;
    case 'lq':S.cart[i].qty+=d;if(S.cart[i].qty<=0)S.cart.splice(i,1);renderCart();break;
    case 'ldel':S.cart.splice(i,1);renderCart();break;
    case 'ledit':openPicker(S.cart[i].grpKey,i);break;
    case 'pkSel':PK.sel=v;renderPicker();break;
    case 'pkAd':PK.ad[v]=Math.max(0,(PK.ad[v]||0)+d);renderPicker();break;
    case 'pkQty':PK.qty=Math.max(1,PK.qty+d);renderPicker();break;
    case 'pkNote':var nt=(' '+PK.note+' ');PK.note=(nt.indexOf(' '+v+' ')>=0?nt.replace(' '+v+' ',' '):nt+v).replace(/\s+/g,' ').trim();renderPicker();break;
    case 'pkOk':pickerOk();break;
    case 'openPay':openPay();break;
    case 'pDisc':P.disc=!v?null:(v==='__custom'?{id:'__custom',type:P.custom.type,value:num(P.custom.value)||0}:promoById(v));renderPay();break;
    case 'cdType':P.custom.type=v;P.disc.type=v;renderPay();break;
    case 'pMethod':P.method=v;renderPay();break;
    case 'pSplit':P.split=!P.split;P.lines=[];renderPay();break;
    case 'spAdd':var ap=activePay();P.lines.push({m:ap[0]?ap[0].id:'cash',amt:''});$('splitBox').innerHTML=splitHTML(payNet());bindSplit();break;
    case 'spDel':P.lines.splice(i,1);$('splitBox').innerHTML=splitHTML(payNet());bindSplit();break;
    case 'pQuick':P.received=v==='exact'?String(payNet()):v;$('rcv').value=P.received;updChange();break;
    case 'payOk':if(!t.disabled)confirmPay();break;
    case 'printO':var po=BILLCACHE[v]||ORD[v];if(po)printOrder(po);break;
    case 'drawer':openDrawer();break;
    case 'drawerPin':needPin('PIN เปิดลิ้นชัก',openDrawer);break;
    case 'close':closeModal();break;
    case 'shadeClose':if(!PIN.cb||$('pdots')==null)closeModal();else closeModal();break;
    case 'pin':pinKey(v);break;
    case 'bd':S.billDate=d===0?ymd():addDays(S.billDate,d);renderBills();break;
    case 'billOpen':openBill(v);break;
    case 'voidO':askVoid(v);break;
    case 'vr':$('vrIn').value=v;break;
    case 'voidOk':doVoid(v);break;
    case 'sd':S.sumDate=d===0?ymd():addDays(S.sumDate,d);renderSummary();break;
    case 'sumAll':S.sumAll=v==='1';renderSummary();break;
    case 'printSum':if(SUMCACHE)passprnt(summaryHTML(),false);break;
    case 'shOpen':shiftOpen();break;
    case 'shClose':shiftClose();break;
    case 'atab':S.atab=v;renderAdmin();break;
    case 'dr':S.dashRange=v;renderDash();break;
    case 'dAll':S.dashAll=v==='1';renderDash();break;
    case 'mNoPrice':S.menuNoPrice=!S.menuNoPrice;renderMenuAdmin();break;
    case 'mAdd':editMenu(null);break;
    case 'mEdit':editMenu(v);break;
    case 'mSave':saveEdit();break;
    case 'mDel':var md=menuById(v);if(md&&confirm('ปิดการขาย '+md.receipt_name+'?')){md.active=false;saveMenuItem(md,function(){closeModal();renderMenuAdmin();});}break;
    case 'mAct':var ma=menuById(v);ma.active=ma.active===false;saveMenuItem(ma);t.classList.toggle('on',ma.active!==false);break;
    case 'mSo':var ms=menuById(v);if(!ms.so)ms.so={};ms.so[CFG.branch]=!ms.so[CFG.branch];saveMenuItem(ms);t.classList.toggle('on',!!ms.so[CFG.branch]);break;
    case 'seedPrompt':adminGate(function(){if(confirm('ดึงเมนูจากสูตรใน Stock (recipes)?\nจะเพิ่มเฉพาะเมนูที่ยังไม่มี ไม่แก้ราคาที่ตั้งไว้แล้ว'))seedFromRecipes();});break;
    case 'prEdit':editPromo(v);break;
    case 'prSave':var pp=EDIT_ITEM;pp.name=$('p_n').value.trim();pp.type=$('p_t').value;pp.value=num($('p_v').value)||0;if(!pp.name){toast('ใส่ชื่อโปร','err');break;}savePromo(pp,function(){closeModal();renderPromoAdmin();});break;
    case 'prAct':var pr=promoById(v);pr.active=pr.active===false;savePromo(pr,renderPromoAdmin);break;
    case 'payTg':for(var k=0;k<SET.pay.length;k++)if(SET.pay[k].id===v){SET.pay[k].active=!SET.pay[k].active;t.classList.toggle('on',SET.pay[k].active);}break;
    case 'apTg':SET.autoprint=!SET.autoprint;t.classList.toggle('on',SET.autoprint);break;
    case 'setSave':saveSettings();break;
    case 'testPrint':passprnt(receiptHTML({bill_no:'TEST-0000',branch_code:CFG.branch,device:CFG.dev,channel:'walkin',created_at:new Date().toISOString(),items:[{name:'*** ทดสอบการพิมพ์ ***',qty:1,price:0}],subtotal:0,discount:0,total:0,vatable:0,vat:0,payments:[],status:'paid'},true),false);break;
    case 'setupAgain':showSetup();break;
    case 'suBr':SU.branch=v;showSetupSel();break;
    case 'suDev':SU.dev=+v;showSetupSel();break;
    case 'suOk':if(!SU.branch){toast('เลือกสาขาก่อน','err');break;}CFG={branch:SU.branch,dev:SU.dev};lsSet('cfg',CFG);$('setup').style.display='none';SHIFT=null;boot();break;
  }
});
function showSetupSel(){var bs=$('setup').querySelectorAll('[data-act="suBr"]'),ds=$('setup').querySelectorAll('[data-act="suDev"]');
  for(var i=0;i<bs.length;i++)bs[i].classList.toggle('on',bs[i].getAttribute('data-v')===SU.branch);
  for(var j=0;j<ds.length;j++)ds[j].classList.toggle('on',+ds[j].getAttribute('data-v')===SU.dev);}
function closeCart(){$('cart').classList.remove('open');$('cartShade').classList.add('hide');}
$('q').addEventListener('input',function(){S.q=this.value;renderSell();});
window.addEventListener('online',flush);
setInterval(flush,20000);

/* ---------------- boot ---------------- */
function handleReturn(){
  var qs=location.search;
  if(qs.indexOf('passprnt_code')<0)return;
  var code=(qs.match(/passprnt_code=([^&]*)/)||[])[1];
  var msg=decodeURIComponent(((qs.match(/passprnt_message=([^&]*)/)||[])[1]||'').replace(/\+/g,' '));
  try{history.replaceState(null,'',location.pathname);}catch(e){}
  if(code==='0')toast('🖨️ พิมพ์สำเร็จ','ok');else toast('พิมพ์ไม่สำเร็จ ('+code+') '+msg+' — กดพิมพ์ซ้ำจากหน้าบิล','err');
  var lo=lsGet('last_order',null);
  if(lo&&Date.now()-lo.at<120000&&ORD[lo.id]){var o=ORD[lo.id];lsSet('last_order',null);if(o.change_amt!=null&&o.change_amt>0)showDone(o);}
}
function boot(){
  mergeDefaultsPay();
  SHIFT=lsGet('shift_'+CFG.branch,null);
  renderAll();setSync(OUTBOX.length?'err':'busy');
  loadRemote();recoverSeq();loadRecipesQuiet();
  handleReturn();
}
if(!CFG)showSetup();else boot();
</script>
</body>
</html>


