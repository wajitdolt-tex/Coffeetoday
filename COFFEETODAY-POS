    if(o.status==='void'){A.voids++;A.voidAmt+=Number(o.total)||0;continue;}
    A.bills++;A.sub+=+o.subtotal;A.disc+=+o.discount;A.net+=+o.total;A.vatable+=+o.vatable;A.vat+=+o.vat;A.round+=+(o.rounding||0);
    A.ch[o.channel]=(A.ch[o.channel]||0)+(+o.total);A.chCnt[o.channel]=(A.chCnt[o.channel]||0)+1;
    A.hours[new Date(o.created_at).getHours()]+=+o.total;
    A.branch[o.branch_code]=(A.branch[o.branch_code]||0)+(+o.total);
    if(o.discount>0){var pn=o.promo_name||'ส่วนลด';A.promos[pn]=(A.promos[pn]||0)+(+o.discount);}
    for(var j=0;j<o.items.length;j++){var it=o.items[j],k=it.name,amt=it.price*it.qty;
      if(!A.items[k]){A.items[k]={name:k,qty:0,amt:0};A.itemOrder.push(k);}A.items[k].qty+=it.qty;A.items[k].amt+=amt;
      if(it.kind==='snack')A.snack+=amt;else A.drink+=amt;}
    for(var p=0;p<o.payments.length;p++){var py=o.payments[p];
      if(!A.pay[py.m]){A.pay[py.m]={name:py.name,type:py.type,amt:0,cnt:0};A.payOrder.push(py.m);}A.pay[py.m].amt+=+py.amt;A.pay[py.m].cnt++;
      if(py.type==='cash')A.cash+=+py.amt;else A.online+=+py.amt;}
  }
  return A;
}
