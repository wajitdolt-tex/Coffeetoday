    var vs=g.items.length>1?g.items.map(function(x){return x.variant||'ปกติ';}).join(' · '):(g.items[0].variant||'');
    gh+='<button class="card'+(allSo?' so':'')+'" data-act="grp" data-v="'+esc(g.key)+'"><div class="nm">'+esc(g.grp)+'</div>'+(vs?'<div class="vs">'+esc(vs)+'</div>':'')+'<div class="pr">'+(mn===mx?baht(mn):baht(mn)+' – '+baht(mx))+'</div></button>';
  }
  if(!gh){
    gh=MENU.length?'<div class="empty">'+(q?'ไม่พบเมนู “'+esc(S.q)+'”':'ยังไม่มีเมนูที่ตั้งราคาในหมวดนี้')+'</div>'
      :'<div class="empty">ยังไม่มีเมนูในระบบ<br><button class="btn sm" style="max-width:300px;margin:14px auto 0" data-act="seedPrompt">📥 สร้างเมนูจากสูตรใน Stock</button><div class="note" style="margin-top:8px">ต้องรันไฟล์ SQL ใน Supabase ก่อน</div></div>';
  }
  $('grid').innerHTML=gh;
  renderCart();
}
function lineTotal(l){var a=0;for(var i=0;i<l.addons.length;i++)a+=l.addons[i].price*l.addons[i].qty;return r2((l.price+a)*l.qty);}
function cartSub(){var t=0;for(var i=0;i<S.cart.length;i++)t+=lineTotal(S.cart[i]);return r2(t);}
function cartCount(){var c=0;for(var i=0;i<S.cart.length;i++)c+=S.cart[i].qty;return c;}
function renderCart(){
  var h='';
  for(var i=0;i<S.cart.length;i++){var l=S.cart[i],sub=[];
    for(var a=0;a<l.addons.length;a++)sub.push('+ '+esc(l.addons[a].name)+(l.addons[a].qty>1?' ×'+l.addons[a].qty:'')+' ('+baht(l.addons[a].price*l.addons[a].qty)+')');
    if(l.note)sub.push('📝 '+esc(l.note));
    h+='<div class="cl"><div class="r1"><div class="nm">'+esc(l.name)+(sub.length?'<div class="sub">'+sub.join('<br>')+'</div>':'')+'</div><div class="amt">'+baht(lineTotal(l))+'</div></div>'+
      '<div class="r2"><div class="qty"><button data-act="lq" data-i="'+i+'" data-d="-1">−</button><span>'+l.qty+'</span><button data-act="lq" data-i="'+i+'" data-d="1">+</button></div>'+
      '<button class="mini" data-act="ledit" data-i="'+i+'">✏️ แอด/โน้ต</button><button class="mini del" data-act="ldel" data-i="'+i+'">ลบ</button></div></div>';}
  if(!h)h='<div class="empty" style="padding:30px 0">ยังไม่มีรายการ<br>แตะเมนูเพื่อเพิ่ม</div>';
  $('cartList').innerHTML=h;
  var cnt=cartCount(),tot=cartSub();
  $('cCnt').textContent=cnt+' รายการ';$('cTot').textContent=baht(tot);
  $('payBtn').disabled=!cnt;$('payBtn').className='btn'+(S.ch==='lineman'?' lm':'');
  $('cartCh').textContent=S.ch==='lineman'?'· LINE MAN':'';
  $('cbL').textContent=cnt?('🛒 '+cnt+' รายการ · ดูตะกร้า'):'ตะกร้าว่าง';$('cbR').textContent=baht(tot);
  $('cartBar').className=(cnt?'':'zero')+(S.ch==='lineman'?' lm':'');
}

/* ---------------- picker ---------------- */
function groupByKey(k){var gs=groups();for(var i=0;i<gs.length;i++)if(gs[i].key===k)return gs[i];return null;}
function openPicker(key,editIdx){
  var g=groupByKey(key);if(!g)return;
  var line=editIdx!=null?S.cart[editIdx]:null;
  var sel=line?line.mid:null;
  if(!sel){for(var i=0;i<g.items.length;i++)if(!isSoldOut(g.items[i])){sel=g.items[i].id;break;}}
  if(!sel){toast('เมนูนี้หมดแล้ว','err');return;}
  // เมนูเดียว ไม่มีแอด (ขนม) → ใส่ตะกร้าเลย
  if(!line&&g.items.length===1&&g.items[0].kind==='snack'){addLine(g.items[0],1,[],'');return;}
  if(!line&&g.items.length===1&&!addons().length){addLine(g.items[0],1,[],'');return;}
  PK={key:key,sel:sel,qty:line?line.qty:1,ad:{},note:line?line.note:'',edit:editIdx};
  if(line)for(var a=0;a<line.addons.length;a++)PK.ad[line.addons[a].mid]=line.addons[a].qty;
  renderPicker();showModal();
}
function renderPicker(){
  var g=groupByKey(PK.key);if(!g){closeModal();return;}
  var h='<div class="mh"><h2>'+esc(g.grp)+'</h2><button class="x" data-act="close">✕</button></div><div class="mb">';
  h+='<div class="sec">เลือกแบบ</div><div class="opts">';
  for(var i=0;i<g.items.length;i++){var it=g.items[i];
    h+='<button class="opt'+(it.id===PK.sel?' on':'')+'" data-act="pkSel" data-v="'+esc(it.id)+'"'+(isSoldOut(it)?' disabled':'')+'>'+esc(it.variant||'ปกติ')+'<small>'+(isSoldOut(it)?'หมด':baht(priceOf(it,S.ch)))+'</small></button>';}
  h+='</div>';
  var sel=menuById(PK.sel),ads=addons();
  if(sel&&sel.kind!=='snack'&&ads.length){
    h+='<div class="sec">แอดเพิ่ม</div>';
    for(var a=0;a<ads.length;a++){var ad=ads[a],q=PK.ad[ad.id]||0;
      h+='<div class="adl"><div><div class="an">'+esc(ad.receipt_name)+'</div><div class="ap">+'+baht(priceOf(ad,S.ch))+'</div></div><div class="qty"><button data-act="pkAd" data-v="'+esc(ad.id)+'" data-d="-1">−</button><span>'+q+'</span><button data-act="pkAd" data-v="'+esc(ad.id)+'" data-d="1">+</button></div></div>';}
    h+='<div style="height:12px"></div>';
  }
  h+='<div class="sec">หมายเหตุ</div><div class="opts" style="margin-bottom:8px">';
  for(var n=0;n<NOTE_CHIPS.length;n++){var on=(' '+PK.note+' ').indexOf(NOTE_CHIPS[n])>=0;h+='<button class="opt'+(on?' on':'')+'" style="min-width:0;padding:8px 12px" data-act="pkNote" data-v="'+esc(NOTE_CHIPS[n])+'">'+esc(NOTE_CHIPS[n])+'</button>';}
  h+='</div><input class="in" style="width:100%;margin-bottom:14px" id="pkNoteIn" placeholder="พิมพ์หมายเหตุเพิ่ม…" value="'+esc(PK.note)+'">';
  h+='<div style="display:flex;gap:10px;align-items:center"><div class="qty"><button data-act="pkQty" data-d="-1">−</button><span>'+PK.qty+'</span><button data-act="pkQty" data-d="1">+</button></div>'+
     '<button class="btn'+(S.ch==='lineman'?' lm':'')+'" style="flex:1" data-act="pkOk">'+(PK.edit!=null?'บันทึก':'เพิ่มลงตะกร้า')+' · '+baht(pickerTotal())+'</button></div></div>';
  $('modal').className='';$('modal').innerHTML=h;
  $('pkNoteIn').oninput=function(){PK.note=this.value;};
}
function pickerTotal(){var it=menuById(PK.sel);if(!it)return 0;var t=priceOf(it,S.ch);for(var k in PK.ad)if(PK.ad.hasOwnProperty(k)&&PK.ad[k]>0){var a=menuById(k);if(a)t+=priceOf(a,S.ch)*PK.ad[k];}return r2(t*PK.qty);}
function pickerOk(){
  var it=menuById(PK.sel);if(!it)return;
  var ads=[];for(var k in PK.ad)if(PK.ad.hasOwnProperty(k)&&PK.ad[k]>0){var a=menuById(k);if(a)ads.push({mid:a.id,rid:a.recipe_id||null,name:a.receipt_name,price:priceOf(a,S.ch),qty:PK.ad[k],kind:a.kind||'drink'});}
  var note=(PK.note||'').trim();
  if(PK.edit!=null){S.cart.splice(PK.edit,1,mkLine(it,PK.qty,ads,note));renderCart();}
  else addLine(it,PK.qty,ads,note);
  closeModal();
}
function mkLine(it,qty,ads,note){return {k:uid(),mid:it.id,rid:it.recipe_id||null,name:it.receipt_name,variant:it.variant||'',grpKey:(it.category||'อื่นๆ')+'|'+it.grp,price:priceOf(it,S.ch),qty:qty,addons:ads,note:note,kind:it.kind||'drink'};}
function addLine(it,qty,ads,note){
  var sig=it.id+'|'+JSON.stringify(ads)+'|'+note;
  for(var i=0;i<S.cart.length;i++){var l=S.cart[i];if(l.mid+'|'+JSON.stringify(l.addons)+'|'+l.note===sig){l.qty+=qty;renderCart();bump();return;}}
  S.cart.push(mkLine(it,qty,ads,note));renderCart();bump();
}
function bump(){var b=$('cartBar');b.style.transform='scale(1.04)';setTimeout(function(){b.style.transform='';},120);}
function repriceCart(){
  for(var i=0;i<S.cart.length;i++){var l=S.cart[i],it=menuById(l.mid);if(it)l.price=priceOf(it,S.ch);
    for(var a=0;a<l.addons.length;a++){var ad=menuById(l.addons[a].mid);if(ad)l.addons[a].price=priceOf(ad,S.ch);}}
}

/* ---------------- payment ---------------- */
function activePay(){return SET.pay.filter(function(m){return m.active&&m.type!=='lineman';});}
function promoById(id){for(var i=0;i<PROMOS.length;i++)if(PROMOS[i].id===id)return PROMOS[i];return null;}
function discAmt(sub){
  if(!P||!P.disc)return 0;var d=P.disc,v=Number(d.value)||0;
  var a=d.type==='pct'?r2(sub*v/100):r2(v);return Math.max(0,Math.min(a,sub));
}
function openPay(){
  if(!S.cart.length)return;closeCart();
  var ap=activePay();
  P={disc:null,method:S.ch==='lineman'?'lineman':(ap[0]?ap[0].id:'cash'),received:'',split:false,lines:[],lmno:'',custom:{type:'baht',value:''}};
  renderPay();showModal('wide');
}
function payNet(){var sub=cartSub();return r2(sub-discAmt(sub));}
function renderPay(){
  var sub=cartSub(),dis=discAmt(sub),net=r2(sub-dis),lm=S.ch==='lineman';
  var h='<div class="mh"><h2>ชำระเงิน'+(lm?' · LINE MAN':'')+'</h2><button class="x" data-act="close">✕</button></div><div class="mb">';
  h+='<div class="paybig"><div class="k">ยอดที่ต้องชำระ</div><div class="v">'+baht(net)+'</div><div class="s">รวม '+baht(sub)+(dis?' · ส่วนลด −'+baht(dis):'')+'</div></div>';
  // promos
  h+='<div class="sec">โปรส่วนลด</div><div class="opts">';
  h+='<button class="opt'+(!P.disc?' on':'')+'" data-act="pDisc" data-v="">ไม่มี</button>';
  var ps=PROMOS.filter(function(p){return p.active!==false;});
  for(var i=0;i<ps.length;i++)h+='<button class="opt'+(P.disc&&P.disc.id===ps[i].id?' on':'')+'" data-act="pDisc" data-v="'+esc(ps[i].id)+'">'+esc(ps[i].name)+'<small>'+(ps[i].type==='pct'?ps[i].value+'%':'−'+baht(ps[i].value))+'</small></button>';
  h+='<button class="opt'+(P.disc&&P.disc.id==='__custom'?' on':'')+'" data-act="pDisc" data-v="__custom">กำหนดเอง</button></div>';
  if(P.disc&&P.disc.id==='__custom'){
    h+='<div style="display:flex;gap:8px;margin:-6px 0 14px"><input class="in" id="cdVal" inputmode="decimal" placeholder="จำนวน" style="flex:1" value="'+esc(P.custom.value)+'"><div class="seg"><button data-act="cdType" data-v="baht" class="'+(P.custom.type==='baht'?'on':'')+'">บาท</button><button data-act="cdType" data-v="pct" class="'+(P.custom.type==='pct'?'on':'')+'">%</button></div></div>';
  }
  if(lm){
    h+='<div class="sec">ช่องทางชำระ</div><div class="mgrid"><div class="mt on"><span class="ic">🛵</span>LINE MAN</div></div>';
    h+='<label class="lbl">เลขออเดอร์ LINE MAN (ไม่บังคับ)</label><input class="in" id="lmNo" style="width:100%;margin-bottom:14px" value="'+esc(P.lmno)+'" placeholder="เช่น LM-12345">';
  } else {
    h+='<div class="sec" style="display:flex;justify-content:space-between;align-items:center">ช่องทางชำระ <button class="mini" data-act="pSplit">'+(P.split?'↩ จ่ายช่องทางเดียว':'➗ แยกจ่ายหลายช่องทาง')+'</button></div>';
    if(!P.split){
      var ap=activePay();h+='<div class="mgrid">';
      for(var m=0;m<ap.length;m++)h+='<button class="mt'+(P.method===ap[m].id?' on':'')+'" data-act="pMethod" data-v="'+esc(ap[m].id)+'"><span class="ic">'+payIcon(ap[m].type)+'</span>'+esc(ap[m].name)+'</button>';
      h+='</div>';
      var md=payDef(P.method);
      if(md.type==='cash'){
        h+='<label class="lbl">รับเงินมา</label><input class="in" id="rcv" inputmode="decimal" style="width:100%;font-size:24px;font-weight:800;text-align:right" placeholder="'+money(net)+'" value="'+esc(P.received)+'">';
        h+='<div class="quick"><button data-act="pQuick" data-v="exact">พอดี</button>';
        var qs=quickNotes(net);for(var qn=0;qn<qs.length;qn++)h+='<button data-act="pQuick" data-v="'+qs[qn]+'">'+baht(qs[qn])+'</button>';
        h+='</div><div id="chgBox"></div>';
      } else if(md.type==='qr'){
        var pp=BS().promptpay;
        if(pp){h+='<div id="qrBox"></div><div class="note" style="text-align:center;margin-bottom:12px">พร้อมเพย์ '+esc(pp)+' · '+baht(net)+'<br>ตรวจสอบยอดเงินเข้าก่อนกดยืนยัน</div>';}
        else h+='<div class="warnbox">ยังไม่ได้ตั้งเลขพร้อมเพย์ของ'+esc(BR().short)+' (หลังบ้าน → ตั้งค่า) — ใช้ QR ป้ายหน้าร้านไปก่อน</div>';
      } else {
        h+='<div class="note" style="margin-bottom:12px">ตรวจสอบการชำระเงินให้เรียบร้อยก่อนกดยืนยัน</div>';
      }
    } else {
      h+='<div id="splitBox">'+splitHTML(net)+'</div>';
    }
  }
  h+='<button class="btn'+(lm?' lm':'')+'" id="payOk" data-act="payOk">✅ ยืนยันรับเงิน '+baht(net)+'</button>';
  h+='<div class="note" style="text-align:center;margin-top:8px">'+(SET.autoprint?'จะพิมพ์ใบเสร็จอัตโนมัติ':'ไม่พิมพ์อัตโนมัติ (ตั้งค่าในหลังบ้าน)')+'</div></div>';
  $('modal').innerHTML=h;
  if($('cdVal'))$('cdVal').oninput=function(){P.custom.value=this.value;P.disc.value=num(this.value)||0;updPayTotals();};
  if($('lmNo'))$('lmNo').oninput=function(){P.lmno=this.value;};
  if($('rcv'))$('rcv').oninput=function(){P.received=this.value;updChange();};
  bindSplit();
  if($('qrBox'))drawQR($('qrBox'),BS().promptpay,net);
  updChange();validatePay();
}
function updPayTotals(){
  // อัปเดตยอดโดยไม่ re-render ช่องกรอก
  var sub=cartSub(),dis=discAmt(sub),net=r2(sub-dis);
  var pb=document.querySelector('.paybig');if(pb){pb.querySelector('.v').textContent=baht(net);pb.querySelector('.s').textContent='รวม '+baht(sub)+(dis?' · ส่วนลด −'+baht(dis):'');}
  if($('rcv'))$('rcv').placeholder=money(net);
  if($('splitBox'))bindSplit();
  if($('qrBox')){$('qrBox').innerHTML='';drawQR($('qrBox'),BS().promptpay,net);}
  $('payOk').textContent='✅ ยืนยันรับเงิน '+baht(net);
  updChange();validatePay();
}
function payIcon(t){return t==='cash'?'💵':t==='qr'?'📱':t==='lineman'?'🛵':'💳';}
function quickNotes(net){var c=[20,50,100,500,1000],o=[];for(var i=0;i<c.length;i++){var v=Math.ceil(net/c[i])*c[i];if(v>=net&&o.indexOf(v)<0)o.push(v);}o.sort(function(a,b){return a-b;});return o.slice(0,5);}
function updChange(){
  var box=$('chgBox');if(!box)return;var net=payNet(),r=num(P.received);
  if(r==null){box.innerHTML='';return;}
  var c=r2(r-net);box.innerHTML='<div class="change'+(c<0?' bad':'')+'"><span>'+(c<0?'เงินไม่พอ':'เงินทอน')+'</span><span>'+baht(Math.abs(c))+'</span></div>';
